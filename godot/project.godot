[application]
config/name="FantaMiccio"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[input]
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventKey,"physical_keycode":32)]}

[environment]
defaults/default_clear_color=Color(0.08,0.11,0.07,1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[autoload]
GameManager="*res://scripts/core/GameManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
WebBridge="*res://scripts/core/WebBridge.gd"
